# PineGuard maintainer-shell credentials.
#
# Copy to `.env` in this folder and fill in. `.env` is gitignored; this example is committed.
# See README.md for which script consumes each key.
#
# Values are loaded into the CURRENT PROCESS ONLY by .shared/index.ps1 — never persisted to the
# Windows User or Machine environment. Scripts resolve a key through Get-ToolSecret, which checks
# the process environment first and this file second.
#
# Format: KEY = 'value'. Bare and double-quoted values parse too; whitespace around = is ignored.

# GitHub CLI token — every GitHub script here, via `gh`.
# https://cli.github.com/manual/gh_auth_login
GH_TOKEN = ''

# nuget.org API key — Publish-NugetPackage.ps1 (Push scope) and
# Unpublish-NugetPrerelease.ps1 (Unlist Package scope), both on the `PineGuard.*` glob.
# Workstation only: publish.yml never uses this, because it mints its own short-lived key.
# https://nuget.org/account/apikeys
NUGET_TOKEN = ''

# nuget.org profile name. Pushed as the NUGET_USER Actions secret by Set-GithubSecret.ps1;
# publish.yml exchanges it for a short-lived API key via OIDC Trusted Publishing (NuGet/login@v1).
NUGET_USER = 'stevomccormack'

# Qodana Cloud token — Initialize-Qodana.ps1, and pushed as an Actions secret for ci.yml's
# opt-in Qodana job. Optional: without it, scans stay local and upload nothing.
# https://jetbrains.com/help/qodana/cli.html#authentication
# https://qodana.cloud/teams/2096a — PineGuard Team
# https://qodana.cloud/projects/Gg2oj/reports/B5LaqV — PineGuard.NET
QODANA_TOKEN = ''

# SonarQube project token. Generated by tools/code-scan/sonarqube/Initialize-SonarQube.ps1 on
# first commission and written back here; read by tools/code-scan/sonarqube/Run-SonarScanner.ps1.
# http://localhost:9001/account/security — Tokens
# http://localhost:9001/dashboard?id=PineGuard — Dashboard
SONARQUBE_TOKEN = ''

# SonarQube admin password. Also generated by Initialize-SonarQube.ps1 on first commission
# (a random 32-byte value) — not a fixed or default password.
# See docs/ai/specs/scan/spec.md §4.
SONARQUBE_ADMIN_PASSWORD = ''
