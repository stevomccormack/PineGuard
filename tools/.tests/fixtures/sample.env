# Sample .env fixture for the Import-DotEnv Pester tests (tools/.tests/Dotenv-Parser.Tests.ps1).
# Exercises: bare KEY=value, a comment line, a blank line, single- and double-quoted
# values, and whitespace tolerated around '='. Comments and blank lines must be ignored.
FOO=bar

BAZ=123
QUOTED_SINGLE='value with spaces'
QUOTED_DOUBLE="another value"
SPACED_EQUALS = trimmed
