<Project>
  <PropertyGroup>
    <TargetFrameworks>netstandard2.1;net8.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- CS8795: Partial method with [GeneratedRegex] — source generator provides the implementation at compile time.
         ReSharper's own parser doesn't execute source generators, so it false-positives this as a compiler error. -->
    <NoWarn>$(NoWarn);CS8795</NoWarn>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <!-- CS0419 (netstandard2.1 only): System.Text.Json's netstandard dependency chain ships an
         internal CallerArgumentExpressionAttribute polyfill; cref binding sees it alongside the
         PineGuard public polyfill and reports a phantom ambiguity while still resolving correctly. -->
    <NoWarn Condition="'$(TargetFramework)' == 'netstandard2.1'">$(NoWarn);CS0419</NoWarn>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsPackable)' != 'false' and '$(IsTestProject)' != 'true'">
    <Authors>Steve McCormack</Authors>
    <Company>stevomccormack</Company>
    <Copyright>Copyright © 2026 Steve McCormack</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/stevomccormack/PineGuard</PackageProjectUrl>
    <RepositoryUrl>https://github.com/stevomccormack/PineGuard</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageIcon>pineguard-logo-128px.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>validation;validator;input-validation;model-validation;validation-rules;defensive-programming;owasp;csharp;dotnet</PackageTags>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerDefaultPreReleaseIdentifiers>alpha.0</MinVerDefaultPreReleaseIdentifiers>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' != 'false' and '$(IsTestProject)' != 'true'">
    <PackageReference Include="MinVer" PrivateAssets="all" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
  </ItemGroup>
</Project>
