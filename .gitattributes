# ===================================================================
# Line endings — LF everywhere, on every platform
# ===================================================================
# Git stores LF in the repository and checks out LF on every platform.
# `eol=lf` here overrides `core.autocrlf=true` (the Git for Windows
# installer default), so a Windows checkout gets the same LF endings
# that `.editorconfig` (`end_of_line = lf`) tells `dotnet format` to
# write. The two agree, so formatting never rewrites a line ending and
# git never reports phantom "modified" files after a format pass.
#
# After pulling this change into a checkout that still has CRLF files,
# refresh the working tree once (clean tree required):
#     git rm -rq --cached . && git reset -q --hard
# ===================================================================

* text=auto eol=lf

# ===================================================================
# Explicitly text files — normalise to LF in repo and checkout
# ===================================================================
*.cs        text
*.csproj    text
*.props     text
*.targets   text
*.sln       text
*.slnx      text
*.md        text
*.txt       text
*.json      text
*.xml       text
*.yaml      text
*.yml       text
*.config    text
*.ruleset   text
*.editorconfig text
*.gitattributes text
*.gitignore text
*.ps1       text
*.psm1      text
*.psd1      text
*.sh        text eol=lf

# CMD batch files are the one format that needs CRLF (matches .editorconfig)
*.cmd       text eol=crlf
*.bat       text eol=crlf

# ===================================================================
# Binary files — never normalise
# ===================================================================
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.zip       binary
*.gz        binary
*.7z        binary
*.nupkg     binary
*.snupkg    binary
*.dll       binary
*.exe       binary
*.pdb       binary
*.pdf       binary
