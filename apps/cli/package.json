{
  "name": "@pineguard/cli",
  "version": "0.0.0",
  "private": true,
  "description": "PineGuard engineering CLI (pineguard audit ...). See docs/ai/plans/audit-cli-rebuild.md.",
  "type": "module",
  "bin": {
    "pineguard": "./dist/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "commander": "15.0.0",
    "mdast-util-from-markdown": "2.0.3",
    "remark": "15.0.1",
    "remark-frontmatter": "5.0.0",
    "remark-parse": "11.0.0",
    "tree-sitter-c-sharp": "0.23.5",
    "unist-util-visit": "5.1.0",
    "web-tree-sitter": "0.27.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.1",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "tsup": "8.5.1",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
