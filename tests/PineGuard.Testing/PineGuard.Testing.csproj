<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsTestProject>false</IsTestProject>
    <!-- TFMs inherited from tests/Directory.Build.props: net8.0;net10.0. netstandard2.1 is intentionally excluded — fixtures reference TimeOnly (net6.0+) unconditionally. -->
    <GenerateRuntimeConfigurationFiles>false</GenerateRuntimeConfigurationFiles>
    <Description>Shared fixtures, base test classes, and assertion helpers for consumers writing PineGuard-based validation tests.</Description>
    <PackageTags>xunit;testing;test-fixtures;validation-testing;pineguard</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\docs\brand\pineguard-icon-128px.png" Pack="true" PackagePath="\" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PineGuard.Testing.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PineGuard.Core\PineGuard.Core.csproj" />
  </ItemGroup>

</Project>
