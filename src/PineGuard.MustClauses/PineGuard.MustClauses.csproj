<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Result-based composable validators. Must.Be.Email(value) returns a MustResult that the caller inspects or escalates.</Description>
    <PackageTags>$(PackageTags);must-clauses;result-type;railway-oriented;functional-error-handling</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\docs\brand\pineguard-icon.png" Pack="true" PackagePath="\" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PineGuard.MustClauses.UnitTests" />
    <!-- PineGuard.FluentValidation and PineGuard.DataAnnotations call the internal Must.Be.PastDateOnly
         overload that takes the null policy, so the string past-date rule object decides null for them and
         neither adapter carries a null branch of its own. -->
    <InternalsVisibleTo Include="PineGuard.FluentValidation" />
    <InternalsVisibleTo Include="PineGuard.DataAnnotations" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" />
    <ProjectReference Include="..\PineGuard.Core\PineGuard.Core.csproj" />
  </ItemGroup>

</Project>
